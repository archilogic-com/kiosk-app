# Point the kiosk at your own floor.
# All values are safe in a client bundle: a publishable access token is
# read-only and restricted to the domains you allow when you create it.
#
# Create a token: https://app.archilogic.com/organization/settings/access-tokens
# Find a floor id: open the floor in https://app.archilogic.com and copy it from the URL
#
# Leave a value blank (or omit this file) to use the public demo floor's value.
# Every value can also be overridden per visit with a URL parameter (see the README).

VITE_ARCHILOGIC_PUBLISHABLE_ACCESS_TOKEN=
# Set a floor id (common case) or a layout id to target one specific layout.
VITE_ARCHILOGIC_FLOOR_ID=
VITE_ARCHILOGIC_LAYOUT_ID=
# The Space API for another tenant. Blank uses https://api.archilogic.com.
VITE_ARCHILOGIC_SPACE_API_URL=
# apiFieldNames of the workstation custom attributes that hold occupants.
VITE_ARCHILOGIC_OCCUPANT_ATTRIBUTE=
VITE_ARCHILOGIC_EMPLOYEE_ID_ATTRIBUTE=
