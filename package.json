{
  "name": "archilogic-kiosk-example",
  "version": "1.0.0",
  "description": "A wall-mounted floor plan kiosk built with the Archilogic Floor Plan SDK: search, wayfinding, people finder and live theming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archilogic-com/kiosk-app.git"
  },
  "homepage": "https://github.com/archilogic-com/kiosk-app#readme",
  "bugs": {
    "url": "https://github.com/archilogic-com/kiosk-app/issues"
  },
  "keywords": [
    "archilogic",
    "floor-plan",
    "kiosk",
    "wayfinding",
    "indoor-maps"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --check .",
    "check": "prettier --write . && oxlint --fix"
  },
  "dependencies": {
    "@archilogic/floor-plan-sdk": "^5.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  }
}
